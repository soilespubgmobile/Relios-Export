<Window x:Class="ReliosExport.KirpmaPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a="clr-namespace:ReliosExport.Arayuz"
        Title="Kırpma önizlemesi"
        Width="1100" Height="760" MinWidth="760" MinHeight="520"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgSurface}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <DockPanel Margin="18,16,18,14">

        <!-- Üst: video, kare, kırpma konumu -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Video" Style="{StaticResource AlanEtiketi}" Margin="0,0,10,0"/>
            <ComboBox x:Name="VideoSecimi" Grid.Column="1" SelectionChanged="OnVideoDegisti"/>
            <Button Grid.Column="2" Content="Başka kare" Style="{StaticResource SecondaryButton}" Height="28" Padding="12,0" Margin="8,0,0,0"
                    Click="OnBaskaKare" ToolTip="Videonun başka bir yerinden kare al"/>
            <TextBlock Grid.Column="4" Text="Kırpma konumu" Style="{StaticResource AlanEtiketi}" Margin="0,0,10,0"/>
            <ComboBox Grid.Column="5" ItemsSource="{x:Static a:Secenekler.KirpmaYataylar}" DisplayMemberPath="Ad" SelectedValuePath="Deger"
                      SelectedValue="{Binding KirpmaYatay}" ToolTip="Yatay video dikeye kırpılırken"/>
            <ComboBox Grid.Column="7" ItemsSource="{x:Static a:Secenekler.KirpmaDikeyler}" DisplayMemberPath="Ad" SelectedValuePath="Deger"
                      SelectedValue="{Binding KirpmaDikey}" ToolTip="Uzun dikey video kırpılırken"/>
        </Grid>

        <!-- Alt: bilgi + kapat -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="Bilgi" Style="{StaticResource Ipucu}" FontSize="12" VerticalAlignment="Center" Margin="0,0,120,0"/>
            <Button Content="Kapat" Style="{StaticResource SecondaryButton}" MinWidth="96" HorizontalAlignment="Right" IsCancel="True"/>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10">
                <DockPanel>
                    <TextBlock x:Name="KaynakBaslik" DockPanel.Dock="Top" Text="Kaynak" Style="{StaticResource AltBaslik}" Margin="0,0,0,8"/>
                    <Viewbox Stretch="Uniform">
                        <Grid x:Name="KaynakAlan" Width="16" Height="9">
                            <Image x:Name="KaynakResim" Stretch="Fill"/>
                            <Path x:Name="Karartma" Fill="#A6000000" IsHitTestVisible="False"/>
                            <Rectangle x:Name="Cerceve" Stroke="{StaticResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                    </Viewbox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10">
                <DockPanel>
                    <TextBlock x:Name="CiktiBaslik" DockPanel.Dock="Top" Text="Çıktı" Style="{StaticResource AltBaslik}" Margin="0,0,0,8"/>
                    <Grid>
                        <Image x:Name="CiktiResim" Stretch="Uniform"/>
                        <TextBlock x:Name="Durum" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="10"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
