<Window x:Class="ReliosExport.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relios Export"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgSurface}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Border Padding="22,18,22,16" MinWidth="360" MaxWidth="460">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="MessageText" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="BtnNo" Style="{StaticResource SecondaryButton}" MinWidth="104" IsCancel="True" IsDefault="True" Click="OnNo"/>
                <Button x:Name="BtnYes" Style="{StaticResource DangerButton}" MinWidth="104" Margin="8,0,0,0" Click="OnYes"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
