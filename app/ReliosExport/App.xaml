<Application x:Class="ReliosExport.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="clr-namespace:ReliosExport.Arayuz"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Ayar paneli ve ayar pencerelerinin ortak dönüştürücüleri -->
            <a:EsitseGorunur x:Key="Gorunur"/>
            <a:DogruysaGorunur x:Key="DogruysaGorunur"/>
            <a:BosSecenek x:Key="Bos"/>
            <a:ListeDisi x:Key="ListeDisi"/>
            <a:Sayi x:Key="Sayi"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
