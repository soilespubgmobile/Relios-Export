<Window x:Class="ReliosExport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relios Export" Width="760" Height="560" MinWidth="620" MinHeight="460"
        Background="{StaticResource Bg}" AllowDrop="True"
        Drop="OnDrop" DragOver="OnDragOver" WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Relios Export" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Videoları sürükleyip bırak, platformu seç, başlat." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Platform -->
        <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Platform" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <RadioButton x:Name="RbTikTok" Content="TikTok" GroupName="Platform" IsChecked="True" Checked="OnProfileChanged"/>
                    <RadioButton x:Name="RbYouTube" Content="YouTube" GroupName="Platform" Checked="OnProfileChanged"/>
                </StackPanel>
                <TextBlock x:Name="ProfileInfo" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Dosya listesi -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
                <TextBlock x:Name="DropHint" Text="Videoları buraya sürükle ya da &quot;Video ekle&quot;ye bas"
                           Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ItemsControl x:Name="FileList" Margin="8">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" Margin="0,0,0,6" CornerRadius="8" Background="{StaticResource Bg}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ProgressBar Grid.Column="1" Height="6" VerticalAlignment="Center" Margin="12,0,0,0"
                                                 Minimum="0" Maximum="1" Value="{Binding Progress}"
                                                 Foreground="{StaticResource Accent}" Background="{StaticResource Line}" BorderThickness="0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Çıkış klasörü -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Kayıt yeri" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold"/>
            <TextBlock x:Name="OutputFolderText" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="2" Content="Değiştir" Style="{StaticResource SecondaryButton}" Padding="12,6" Click="OnChooseFolder"/>
        </Grid>

        <!-- Alt çubuk -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnAdd" Content="Video ekle" Style="{StaticResource SecondaryButton}" Click="OnAddFiles"/>
            <Button x:Name="BtnClear" Grid.Column="1" Content="Listeyi temizle" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OnClear"/>
            <TextBlock x:Name="StatusText" Grid.Column="2" VerticalAlignment="Center" Margin="14,0" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="BtnStart" Grid.Column="3" Content="Başlat" Style="{StaticResource PrimaryButton}" Click="OnStartOrCancel"/>
        </Grid>
    </Grid>
</Window>
