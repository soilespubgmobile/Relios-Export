<Window x:Class="ReliosExport.FdkPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a="clr-namespace:ReliosExport.Arayuz"
        Title="FDK AAC ayarları"
        Width="640" Height="540" MinWidth="520" MinHeight="400"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgSurface}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <DockPanel Margin="18,16,18,14">

        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Vazgeç" Style="{StaticResource SecondaryButton}" MinWidth="96" IsCancel="True"/>
                <Button Content="Tamam" Style="{StaticResource PrimaryButton}" MinWidth="96" Margin="8,0,0,0" IsDefault="True" Click="OnTamam"/>
            </StackPanel>
        </Grid>

        <TabControl>

            <!-- ================= Ana ================= -->
            <TabItem Header="Ana">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="2,0,8,0">
                        <DockPanel Style="{StaticResource FormSatiri}">
                            <TextBlock Text="Profil" Style="{StaticResource PencereEtiketi}"/>
                            <ComboBox ItemsSource="{x:Static a:Secenekler.FdkProfiller}" DisplayMemberPath="Ad" SelectedValuePath="Deger" SelectedValue="{Binding Profil}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormSatiri}">
                            <TextBlock Text="Kodlama modu" Style="{StaticResource PencereEtiketi}"/>
                            <ComboBox ItemsSource="{x:Static a:Secenekler.FdkModlari}" DisplayMemberPath="Ad" SelectedValuePath="Deger" SelectedValue="{Binding Mod}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormSatiri}" Visibility="{Binding Mod, Converter={StaticResource Gorunur}, ConverterParameter=Cbr}">
                            <TextBlock Text="Bit hızı (kb/s)" Style="{StaticResource PencereEtiketi}"/>
                            <TextBox Style="{StaticResource SayiKutusu}" Tag="" Text="{Binding BitHizi, Converter={StaticResource Sayi}, UpdateSourceTrigger=LostFocus}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormSatiri}">
                            <TextBlock Text="Kesim frekansı (Hz)" Style="{StaticResource PencereEtiketi}"/>
                            <TextBox Style="{StaticResource SayiKutusu}" Tag="" Text="{Binding Kesim, Converter={StaticResource Sayi}, UpdateSourceTrigger=LostFocus}"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Ipucu}" Margin="220,-2,0,10" Text="0: kodlayıcı bit hızına göre seçer."/>
                        <DockPanel Style="{StaticResource FormSatiri}">
                            <TextBlock Text="SBR / PS bildirimi" Style="{StaticResource PencereEtiketi}"/>
                            <ComboBox ItemsSource="{x:Static a:Secenekler.FdkSinyaller}" DisplayMemberPath="Ad" SelectedValuePath="Deger" SelectedValue="{Binding Sinyal}"/>
                        </DockPanel>
                        <CheckBox Content="Afterburner (daha yüksek kalite, biraz daha yavaş)" IsChecked="{Binding Afterburner}" Margin="0,4,0,10"/>
                        <TextBlock Style="{StaticResource Ipucu}" Margin="0,0,0,4"
                                   Text="HE-AAC ve HE-AAC v2 düşük bit hızları içindir; 128 kb/s ve üstünde AAC-LC daha iyi sonuç verir."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Gelişmiş ================= -->
            <TabItem Header="Gelişmiş">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="2,0,8,0">
                        <TextBlock Text="DİNAMİK ARALIK (DRC) BİLGİSİ" Style="{StaticResource AltBaslik}" Margin="0,0,0,8"/>
                        <DockPanel Style="{StaticResource FormSatiri}">
                            <TextBlock Text="DRC profili" Style="{StaticResource PencereEtiketi}"/>
                            <ComboBox ItemsSource="{x:Static a:Secenekler.DrcProfilleri}" DisplayMemberPath="Ad" SelectedValuePath="Deger"
                                      SelectedValue="{Binding DrcProfili, Converter={StaticResource Bos}}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormSatiri}">
                            <TextBlock Text="Sıkıştırma profili" Style="{StaticResource PencereEtiketi}"/>
                            <ComboBox ItemsSource="{x:Static a:Secenekler.DrcProfilleri}" DisplayMemberPath="Ad" SelectedValuePath="Deger"
                                      SelectedValue="{Binding SikistirmaProfili, Converter={StaticResource Bos}}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormSatiri}">
                            <TextBlock Text="DRC hedef seviyesi (dB)" Style="{StaticResource PencereEtiketi}"/>
                            <TextBox Style="{StaticResource SayiKutusu}" Tag="kullanılmaz" Text="{Binding DrcHedef, Converter={StaticResource Sayi}, UpdateSourceTrigger=LostFocus}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormSatiri}">
                            <TextBlock Text="Sıkıştırma hedef seviyesi (dB)" Style="{StaticResource PencereEtiketi}"/>
                            <TextBox Style="{StaticResource SayiKutusu}" Tag="kullanılmaz" Text="{Binding SikistirmaHedef, Converter={StaticResource Sayi}, UpdateSourceTrigger=LostFocus}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormSatiri}">
                            <TextBlock Text="Program referans seviyesi (dB)" Style="{StaticResource PencereEtiketi}"/>
                            <TextBox Style="{StaticResource SayiKutusu}" Tag="kullanılmaz" Text="{Binding ProgramSeviyesi, Converter={StaticResource Sayi}, UpdateSourceTrigger=LostFocus}"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Ipucu}" Margin="0,4,0,4"
                                   Text="Seviyeler -31 ile 0 dB arasıdır. Bu bilgiler sese dokunmaz; yalnızca oynatıcıya dinamik aralığı nasıl ayarlayacağını söyler. Boş bırakılırsa yazılmaz."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Komut ================= -->
            <TabItem Header="Komut">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Ipucu}" Margin="0,8,0,0"
                               Text="Gecikme, ses seviyesi, örnekleme hızı ve kanal ana paneldeki 'Ses' bölümünden gelir. Aynı adlı ses dosyası kullanılırsa sonuna ayrıca apad ve -shortest eklenir."/>
                    <TextBox x:Name="KomutKutusu" Style="{StaticResource InputArea}" IsReadOnly="True" IsReadOnlyCaretVisible="True"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
